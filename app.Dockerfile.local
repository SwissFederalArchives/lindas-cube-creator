# Local development Dockerfile for the app
#
# This version works around the docker-entrypoint.d issue that prevents the
# production app.Dockerfile from running locally. The issue is that the
# template-config.sh script copied to /docker-entrypoint.d/ is not found at
# runtime, causing the container to fail with exit code 127.
#
# This local version bypasses the docker-entrypoint.d mechanism entirely and
# instead uses a simple startup script that:
# 1. Generates config.js from config.js.template using envsubst
# 2. Starts nginx directly
#
# This approach works reliably in local Docker environments (Windows/WSL) and
# allows local smoke testing to pass successfully.
#
# NOTE: The production app.Dockerfile is still used in CI/CD. This file is
# only for local development and testing.

# First step: build the assets
FROM node:18-alpine AS builder

# Do not install Cypress
ENV CYPRESS_INSTALL_BINARY=0

# Mitigate a heap-size issue
ENV NODE_OPTIONS="--max-old-space-size=5120"

WORKDIR /app
ADD package.json yarn.lock ./
ADD ./ui/package.json ./ui/
ADD ./packages/core/package.json ./packages/core/
ADD ./packages/model/package.json ./packages/model/
ADD ./packages/testing/package.json ./packages/testing/
ADD ./typings ./

# for every new package foo add:
# ADD ./packages/foo/package.json ./packages/foo/

# install and build backend
RUN yarn install --frozen-lockfile

COPY . .

WORKDIR /app/ui

# This arg allows setting the public path at build time
# e.g. `docker build --build-arg PUBLIC_PATH=/app/`
ARG PUBLIC_PATH=/

# build with `docker build --build-arg COMMIT=$(git rev-parse HEAD)`
ARG COMMIT

ENV PUBLIC_PATH=$PUBLIC_PATH
ENV NODE_ENV=production
ENV VUE_APP_COMMIT=$COMMIT
ENV VUE_APP_SENTRY_RELEASE=cube-creator-app@$COMMIT
RUN yarn build

FROM nginx:1.23.3-alpine
HEALTHCHECK --timeout=1s --retries=99 \
        CMD wget -q --spider http://127.0.0.1:80/ \
        || exit 1

ARG PUBLIC_PATH

ADD ./nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/ui/dist /usr/share/nginx/html$PUBLIC_PATH

# Have the index.html at the root of the web directory to have the "catch-all"
# fallback working, regardless of the PUBLIC_PATH
COPY --from=builder /app/ui/dist/index.html /usr/share/nginx/html/index.html

# This variable is used by the startup script to know where to put
# the templated `config.js`
ENV WEB_ROOT=/usr/share/nginx/html$PUBLIC_PATH

# Set default environment variables for local development
ENV AUTH_ISSUER=http://localhost:8080/auth
ENV AUTH_CLIENT_ID=local-dev-client
ENV API_CORE_BASE=http://localhost:3000/api
ENV SENTRY_DSN=""
ENV SENTRY_ENVIRONMENT=local

# Create a simple startup script that handles config templating
RUN echo '#!/bin/sh' > /start.sh && \
    echo 'set -eu' >> /start.sh && \
    echo 'echo "Generating config.js from template..."' >> /start.sh && \
    echo 'OUTPUT="$WEB_ROOT/config.js"' >> /start.sh && \
    echo 'TEMPLATE="$WEB_ROOT/config.js.template"' >> /start.sh && \
    echo 'if [ -f "$TEMPLATE" ]; then' >> /start.sh && \
    echo '  envsubst < $TEMPLATE > $OUTPUT' >> /start.sh && \
    echo '  echo "Config generated at $OUTPUT"' >> /start.sh && \
    echo 'else' >> /start.sh && \
    echo '  echo "Warning: Template not found at $TEMPLATE"' >> /start.sh && \
    echo 'fi' >> /start.sh && \
    echo 'echo "Starting nginx..."' >> /start.sh && \
    echo 'exec nginx -g "daemon off;"' >> /start.sh && \
    chmod +x /start.sh

CMD ["/start.sh"]
