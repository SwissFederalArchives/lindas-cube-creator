{
  "name": "@cube-creator/e2e-test",
  "version": "1.0.0",
  "description": "End-to-end tests for Lindas Cube Creator",
  "main": "index.js",
  "scripts": {
    "test": "jest --runInBand",
    "test:api": "jest --runInBand --testPathPattern=api",
    "test:ui": "jest --runInBand --testPathPattern=ui",
    "test:watch": "jest --watch --runInBand"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "supertest": "^6.3.0",
    "playwright": "^1.40.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^2.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": 'ts-jest',
    "testEnvironment": "node",
    "testTimeout": 120000,
    "maxWorkers": 1,
    "testMatch": [
      '**/tests/**/*.test.ts'
    ],
    "moduleFileExtensions": ['ts', 'js', 'json'],
    "collectCoverage": false,
    "verbose": true
  }
}
